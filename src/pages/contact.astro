---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Card from "../components/ui/Card.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import ContactForm from "../components/react/ContactForm";
import { SITE, SOCIAL_LINKS } from "@config/site";
---

<BaseLayout title="Contact Us | Laravel Seo" description="Get in touch with the Laravel Seo team. Contact us for support, sales inquiries, or partnership opportunities.">
  <BreadcrumbSchema items={[
    { name: "Home", href: "/" },
    { name: "Contact", href: "/contact" },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Laravel Seo",
    "description": "Get in touch with the Laravel Seo team for support, sales inquiries, or partnership opportunities.",
    "url": "https://laravelseo.com/contact",
    "mainEntity": {
      "@type": "Organization",
      "name": "Laravel Seo",
      "email": "support@laravelseo.com",
      "contactType": "customer service"
    }
  })} />

  <section class="relative py-24 overflow-hidden bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Contact Us</h1>
        <p class="text-xl text-slate-300">Have a question or need help? We are here for you.</p>
      </div>
    </div>
  </section>

  <Section background="dark">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <div>
          <h2 class="text-2xl font-bold text-white mb-6">Get In Touch</h2>
          <p class="text-slate-300 mb-8 leading-relaxed">
            Whether you need technical support, have questions about our Laravel SEO package, or are interested in partnership opportunities, we would love to hear from you.
          </p>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-violet-500/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Email</h3>
                <a href="mailto:support@laravelseo.com" class="text-violet-400 hover:text-violet-300">support@laravelseo.com</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-pink-500/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Location</h3>
                <p class="text-slate-300">Laravel Company LLC</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-violet-500/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Support Hours</h3>
                <p class="text-slate-300">Monday - Friday, 9 AM - 6 PM EST</p>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-8 border-t border-slate-800">
            <h3 class="font-semibold text-white mb-4">Follow Us</h3>
            <div class="flex gap-4">
              <a href={SOCIAL_LINKS.linkedin} class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-violet-600 hover:text-white transition-all" aria-label="LinkedIn">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href={SOCIAL_LINKS.twitter} class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-violet-600 hover:text-white transition-all" aria-label="Twitter">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
              </a>
              <a href={SOCIAL_LINKS.facebook} class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-violet-600 hover:text-white transition-all" aria-label="Facebook">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div>
          <Card hover={false} class="p-8">
            <h2 class="text-2xl font-bold text-white mb-6">Send Us a Message</h2>
            <ContactForm client:load />
          </Card>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
