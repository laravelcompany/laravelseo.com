---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Card from "../../components/ui/Card.astro";

const blogLoaders = import.meta.glob(["./*.astro", "./*.md"], {
  query: "?raw",
  import: "default",
});

const blogFiles = Object.entries(blogLoaders).filter(
  ([filePath]) => !/index\.(astro|md)$/.test(filePath)
);

function unescapeJsString(raw: string): string {
  return raw.replace(/\\(["\\])/g, "$1");
}

function extractConst(source: string, name: string): string | undefined {
  const match = source.match(
    new RegExp(`const\\s+${name}\\s*=\\s*"((?:[^"\\\\]|\\\\.)*)"`, "s")
  );
  return match ? unescapeJsString(match[1]) : undefined;
}

function extractProp(source: string, name: string): string | undefined {
  const match = source.match(
    new RegExp(`<BlogPost[^>]*\\b${name}\\s*=\\s*"((?:[^"\\\\]|\\\\.)*)"`, "s")
  );
  return match ? unescapeJsString(match[1]) : undefined;
}

function parseMarkdownMeta(source: string): Record<string, string> {
  const block = source.match(/^---\r?\n([\s\S]*?)\r?\n---/);
  if (!block) return {};
  const meta: Record<string, string> = {};
  for (const line of block[1].split(/\r?\n/)) {
    const match = line.match(/^(\w+):\s*"((?:[^"\\]|\\.)*)"\s*$/);
    if (match) meta[match[1]] = unescapeJsString(match[2]);
  }
  return meta;
}

const raw48: Array<{ filePath: string; sourceType: string; sourceLen: number; sourceHead: string }> = [];
const preFilter48: Array<{ slug: string; title: string; date: string }> = [];
const dropped: Array<{ slug: string; title: string; date: string }> = [];
const articles = (
  await Promise.all(
    blogFiles.map(async ([filePath, load]) => {
      const source = (await load()) as string;
      const slug = filePath.replace(/^.*[\\/]/, "").replace(/\.(astro|md)$/, "");
      const meta: Record<string, string | undefined> = filePath.endsWith(".md")
        ? parseMarkdownMeta(source)
        : {
            title: extractConst(source, "title"),
            description: extractConst(source, "description"),
            date: extractConst(source, "date"),
            category: extractProp(source, "category"),
            readTime: extractProp(source, "readTime"),
            tags: extractProp(source, "tags"),
          };
      const article = {
        slug,
        title: meta.title ?? slug,
        description: meta.description ?? "",
        date: meta.date ?? "",
        category: meta.category,
        readTime: meta.readTime,
        tags: meta.tags
          ? meta.tags.split(",").map((tag: string) => tag.trim())
          : undefined,
      };
      if (slug.startsWith("48-")) {
        raw48.push({
          filePath,
          sourceType: typeof source,
          sourceLen: (source ?? "").length,
          sourceHead: (source ?? "").slice(0, 80),
        });
        preFilter48.push(article);
      }
      return article;
    })
  )
)
  .filter((article) => {
    if (article.title) return true;
    dropped.push({ slug: article.slug, title: article.title, date: article.date });
    return false;
  })
  .sort((a, b) => {
    const dateCompare = (b.date || "").localeCompare(a.date || "");
    if (dateCompare !== 0) return dateCompare;
    return numericId(b.slug) - numericId(a.slug);
  });

function numericId(slug: string): number {
  const match = slug.match(/^(\d+)-/);
  return match ? parseInt(match[1], 10) : 0;
}

const ITEMS_PER_PAGE = 6;
const totalPosts = articles.length;
const totalPages = Math.ceil(totalPosts / ITEMS_PER_PAGE);
const currentPage = Number(Astro.url.searchParams.get("page")) || 1;
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const endIndex = startIndex + ITEMS_PER_PAGE;
const paginatedArticles = articles.slice(startIndex, endIndex);

function getPageUrl(page: number) {
  return page === 1 ? "/blog" : `/blog?page=${page}`;
}

function getPageNumbers(current: number, total: number): number[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  if (current <= 4) return [1, 2, 3, 4, 5, 6, 7];
  if (current >= total - 3) return [total - 6, total - 5, total - 4, total - 3, total - 2, total - 1, total];
  return [current - 3, current - 2, current - 1, current, current + 1, current + 2, current + 3];
}
---

<BaseLayout
  title="Laravel SEO Blog - Tips, Guides & Best Practices"
  description="Expert articles about Laravel SEO optimization, meta tags, structured data, and technical SEO best practices for Laravel developers."
>
  <BreadcrumbSchema items={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog" },
  ]} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Laravel SEO Blog",
    "description": "Expert articles about Laravel SEO optimization, meta tags, structured data, and technical SEO best practices.",
    "url": "https://laravelseo.com/blog",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": articles.map((article, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `https://laravelseo.com/blog/${article.slug}`
      }))
    }
  })} />

  <section class="relative py-24 overflow-hidden bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Laravel SEO Blog</h1>
        <span id="debug-info" style="display:none">{totalPosts}::blogs={blogFiles.length}::raw48={JSON.stringify(raw48)}::pre={JSON.stringify(preFilter48)}::dropped={JSON.stringify(dropped)}</span>
        <p class="text-xl text-slate-300">Expert guides, tips, and best practices for optimizing your Laravel applications for search engines.</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 py-16 lg:py-24">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {paginatedArticles.map((article) => (
          <a href={`/blog/${article.slug}`} class="group block">
            <Card hover class="h-full p-6 transition-all group-hover:border-violet-500/50">
              <div class="flex items-center gap-3 mb-4">
                <span class="rounded-full bg-violet-500/10 px-3 py-1 text-xs font-medium text-violet-400">{article.category}</span>
                <span class="text-xs text-slate-500">{article.readTime}</span>
              </div>
              <h2 class="mb-3 text-xl font-bold text-white group-hover:text-violet-400 transition-colors">{article.title}</h2>
              <p class="mb-4 text-sm text-slate-400 leading-relaxed">{article.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-500">{article.date}</span>
                <span class="flex items-center gap-1 text-violet-400 font-medium text-sm">
                  Read More
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </Card>
          </a>
        ))}
      </div>

      {
        totalPages > 1 && (
          <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
            {
              currentPage > 1 && (
                <a
                  href={getPageUrl(currentPage - 1)}
                  class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800"
                >
                  Previous
                </a>
              )
            }

            <div class="flex items-center gap-1">
              {getPageNumbers(currentPage, totalPages).map((pageNum) => {
                const isActive = pageNum === currentPage;
                return (
                  <a
                    href={getPageUrl(pageNum)}
                    class={`min-w-[40px] rounded-lg px-3 py-2 text-sm font-medium transition-colors ${isActive ? "bg-violet-600 text-white" : "border border-slate-700 bg-slate-900 text-slate-300 hover:bg-slate-800"}`}
                  >
                    {pageNum}
                  </a>
                );
              })}
            </div>

            {
              currentPage < totalPages && (
                <a
                  href={getPageUrl(currentPage + 1)}
                  class="rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-300 transition-colors hover:bg-slate-800"
                >
                  Next
                </a>
              )
            }
          </nav>
        )
      }
    </div>
  </section>
</BaseLayout>
