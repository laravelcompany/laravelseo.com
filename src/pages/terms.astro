---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
---

<BaseLayout title="Terms of Service | Laravel Seo" description="Terms of Service for Laravel Seo - Understand the terms governing your use of our Laravel SEO tools and services.">
  <BreadcrumbSchema items={[
    { name: "Home", href: "/" },
    { name: "Terms of Service", href: "/terms" },
  ]} />

  <section class="relative py-24 overflow-hidden bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Terms of Service</h1>
        <p class="text-slate-300">Last updated: 4/7/2026</p>
      </div>
    </div>
  </section>

  <Section background="dark">
    <div class="container mx-auto">
      <div class="max-w-3xl mx-auto prose prose-lg text-slate-300">
        <h2 class="text-2xl font-bold text-white mt-12 mb-4">1. Acceptance of Terms</h2>
        <p class="mb-6 leading-relaxed">
          By accessing or using the Laravel Seo website and services ("the Service"), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use our Service.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">2. Description of Service</h2>
        <p class="mb-6 leading-relaxed">
          Laravel Seo provides automated search visibility and SEO optimization tools built specifically for Laravel applications. Our software package ("laravelseo/core") is licensed, not sold, and is subject to the terms outlined herein.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">3. License Grant</h2>
        <p class="mb-6 leading-relaxed">
          Upon purchase, you are granted a non-exclusive, non-transferable, perpetual license to use the Laravel Seo software for any number of domains or projects. You may not distribute, sublicense, or resell the software without explicit written permission.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">4. Payment Terms</h2>
        <p class="mb-6 leading-relaxed">
          All purchases are one-time payments and include lifetime access to the software as it exists at the time of purchase. Future major version upgrades may be offered at an additional cost. All payments are processed securely through PayPal.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">5. Refund Policy</h2>
        <p class="mb-6 leading-relaxed">
          We offer a 30-day money-back guarantee on all purchases. If you are not satisfied with the software for any reason, contact us within 30 days of purchase for a full refund.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">6. Intellectual Property</h2>
        <p class="mb-6 leading-relaxed">
          All intellectual property rights in the Laravel Seo software and website remain the property of Laravel Company LLC. You may not modify, reverse engineer, or create derivative works based on the software without explicit permission.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">7. Limitation of Liability</h2>
        <p class="mb-6 leading-relaxed">
          Laravel Seo and its parent company shall not be liable for any indirect, incidental, special, consequential, or punitive damages resulting from your use of the Service. The software is provided "as is" without warranty of any kind.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">8. Privacy</h2>
        <p class="mb-6 leading-relaxed">
          Your use of the Service is also governed by our <a href="/privacy" class="text-violet-400 hover:text-violet-300">Privacy Policy</a>, which explains how we collect, use, and protect your personal information.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">9. Changes to Terms</h2>
        <p class="mb-6 leading-relaxed">
          We reserve the right to modify these terms at any time. Changes will be effective immediately upon posting to this page. Your continued use of the Service after changes constitutes acceptance of the new terms.
        </p>

        <h2 class="text-2xl font-bold text-white mt-12 mb-4">10. Contact</h2>
        <p class="mb-6 leading-relaxed">
          For questions about these terms, please contact us at <a href="mailto:support@laravelseo.com" class="text-violet-400 hover:text-violet-300">support@laravelseo.com</a>.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>
