---
import BaseLayout from "./BaseLayout.astro";
import ArticleSchema from "../components/ArticleSchema.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";

export interface Props {
  title: string;
  description: string;
  date: string;
  breadcrumbTitle?: string;
}

const { title, description, date, breadcrumbTitle } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <ArticleSchema {title} {description} {date} />
  <BreadcrumbSchema items={[
    { name: "Home", href: "/" },
    { name: "Blog", href: "/blog" },
    { name: breadcrumbTitle ?? title, href: Astro.url.pathname },
  ]} />
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <slot />
  </article>
</BaseLayout>
