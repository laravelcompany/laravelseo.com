---
const features = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
    title: "SEO",
    description: "Get an in-depth analysis on the most important tags and the content of your webpage."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "Performance",
    description: "Improve the performance of your webpage's with key metrics and suggestions."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: "Security",
    description: "Obtain privacy and security information to keep your webpage's health in good standing."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
    title: "Accessibility",
    description: "Ensure your webpage is accessible to all users with detailed compliance checks."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>`,
    title: "Mobile Friendliness",
    description: "Check how well your webpage performs and displays on mobile devices."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    title: "Core Web Vitals",
    description: "Monitor LCP, FID, and CLS metrics to ensure a smooth user experience across all pages."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: "Best Practices",
    description: "Verify adherence to modern web standards including HTTPS, doctype, and proper resource loading."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
    title: "Social Media",
    description: "Inspect Open Graph, Twitter Cards, and social meta tags for optimal sharing previews."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>`,
    title: "Crawlability",
    description: "Analyze robots.txt, sitemaps, internal linking, and redirect chains for optimal indexing."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>`,
    title: "Content Quality",
    description: "Evaluate readability, keyword usage, duplicate content, and heading structure across pages."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>`,
    title: "Image Optimization",
    description: "Detect oversized images, missing alt text, and improper formats that slow down page load times."
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
    title: "Redirect Audit",
    description: "Identify broken redirect chains, loops, and temporary redirects that should be permanent for SEO equity."
  }
];

const checks = [
  { label: "Title", status: "success", message: "The title tag is perfect." },
  { label: "Meta description", status: "error", message: "The meta description tag is missing or empty." },
  { label: "Load time", status: "success", message: "The webpage loaded in 0.02 seconds." },
  { label: "Structured data", status: "warning", message: "There are no structured data tags on the webpage." },
  { label: "JavaScript defer", status: "neutral", message: "There are 10 javascript resources without the defer attribute." },
  { label: "Content length", status: "success", message: "The webpage has 2,995 words." },
  { label: "H1 tags", status: "error", message: "Multiple H1 tags found on the webpage." },
  { label: "Image alt attributes", status: "warning", message: "3 images are missing alt attributes." },
  { label: "SSL certificate", status: "success", message: "Valid SSL certificate is installed." },
  { label: "Canonical URL", status: "success", message: "Canonical tag is correctly set." },
  { label: "Viewport meta tag", status: "success", message: "Viewport meta tag is properly configured." },
  { label: "Open Graph tags", status: "warning", message: "Missing og:image and og:description tags." }
];
---

<section class="bg-slate-800 py-16 md:py-28" aria-labelledby="advanced-reports-heading">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Right Column - Features (order on desktop) -->
      <div class="order-2 lg:order-1 mt-8 lg:mt-0">
        <div class="bg-slate-900/50 rounded-2xl p-6 shadow-xl border border-slate-700/50">
          <div class="space-y-4">
            {checks.map(check => (
              <div class="flex items-center justify-between p-3 bg-slate-800/50 rounded-xl">
                <div class="flex items-center gap-3">
                  <div class={`w-4 h-4 rounded-full flex items-center justify-center ${
                    check.status === 'success' ? 'bg-green-500' : 
                    check.status === 'error' ? 'bg-red-500' : 
                    check.status === 'warning' ? 'bg-yellow-500' : 'bg-slate-500'
                  }`}>
                    {check.status === 'success' && (
                      <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    )}
                    {check.status === 'error' && (
                      <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    )}
                    {check.status === 'warning' && (
                      <svg class="w-2.5 h-2.5 text-white" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92A5.5 5.5 0 0017.5 19H3.5a5.5 5.5 0 00-4.743 6.099l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                    )}
                  </div>
                  <div>
                    <div class="text-white font-medium">{check.label}</div>
                    <div class="text-slate-400 text-xs">{check.message}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Left Column - Text -->
      <div class="order-1 lg:order-2">
        <h2 id="advanced-reports-heading" class="text-2xl md:text-3xl font-bold text-white mb-4">
          Advanced reports
        </h2>
        <p class="text-slate-300 text-lg mb-8">
          Detailed reports that enables you to take actions on issues that actually matter.
        </p>

        <div class="space-y-6">
          {features.map(feature => (
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-violet-600/20 rounded-xl flex items-center justify-center flex-shrink-0 text-violet-400">
                <Fragment set:html={feature.icon} />
              </div>
              <div>
                <h5 class="text-white font-semibold mb-1">{feature.title}</h5>
                <p class="text-slate-400 text-sm">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>