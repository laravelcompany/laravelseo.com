---
import Section from "../ui/Section.astro";
import Card from "../ui/Card.astro";

const articles = [
  {
    slug: "laravel-seo-best-practices",
    title: "Laravel SEO Best Practices: A Complete Guide for 2026",
    description: "Learn essential Laravel SEO best practices including meta tags, structured data, and performance optimization.",
    category: "Best Practices",
    date: "2026-04-10",
  },
  {
    slug: "optimize-laravel-app-google",
    title: "How to Optimize Your Laravel Application for Google Search",
    description: "Step-by-step guide covering technical SEO, Core Web Vitals, and AI-powered search optimization.",
    category: "Technical SEO",
    date: "2026-04-08",
  },
  {
    slug: "laravel-meta-tags-guide",
    title: "Laravel Meta Tags: Complete Guide to Dynamic SEO Metadata",
    description: "Master dynamic meta tag generation in Laravel for better search visibility and social sharing.",
    category: "Meta Tags",
    date: "2026-04-05",
  },
];
---

<Section background="gray" id="blog">
  <div class="container mx-auto">
    <div class="mx-auto max-w-5xl">
      <div class="mb-12 text-center">
        <span class="mb-4 inline-flex items-center rounded-full bg-violet-500/10 px-4 py-2 text-sm font-semibold text-violet-400">
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          From Our Blog
        </span>
        <h2 class="text-3xl font-bold text-white md:text-4xl">
          Latest <span class="bg-linear-to-r from-violet-400 to-pink-400 bg-clip-text text-transparent">Laravel SEO</span> Articles
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-400">
          Expert guides and best practices to help you optimize your Laravel applications for search engines.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {articles.map((article) => (
          <a href={`/blog/${article.slug}`} class="group block">
            <Card hover class="h-full p-6 transition-all group-hover:border-violet-500/50">
              <div class="mb-3 flex items-center gap-3">
                <span class="rounded-full bg-violet-500/10 px-2.5 py-0.5 text-xs font-medium text-violet-400">{article.category}</span>
                <span class="text-xs text-slate-500">{article.date}</span>
              </div>
              <h3 class="mb-2 text-lg font-bold text-white transition-colors group-hover:text-violet-400">{article.title}</h3>
              <p class="mb-4 text-sm leading-relaxed text-slate-400">{article.description}</p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-violet-400">
                Read More
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </Card>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/blog" class="inline-flex items-center gap-2 rounded-lg border border-slate-700 px-6 py-3 text-sm font-medium text-slate-300 transition-colors hover:border-violet-500 hover:text-violet-400">
          View All Articles
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</Section>
