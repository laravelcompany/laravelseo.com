<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const canvas = document.getElementById('seo-canvas') as HTMLCanvasElement;

(function () {
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);

  const scene = new THREE.Scene();
  const W = canvas.clientWidth, H = canvas.clientHeight;
  const camera = new THREE.PerspectiveCamera(42, W / H, 0.1, 100);
  camera.position.set(0, 1.2, 7);
  camera.lookAt(0, 0, 0);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.minDistance = 3;
  controls.maxDistance = 12;
  controls.maxPolarAngle = Math.PI / 2.2;
  controls.target.set(0, -0.4, 0);
  controls.update();

  function resize() {
    const w = canvas.clientWidth, h = canvas.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener('resize', resize);

  scene.add(new THREE.AmbientLight(0x7c3aed, 0.5));
  const dir = new THREE.DirectionalLight(0xffffff, 1.0);
  dir.position.set(4, 8, 6);
  scene.add(dir);
  const purplePoint = new THREE.PointLight(0x7c3aed, 4, 14);
  purplePoint.position.set(0, 0, 3);
  scene.add(purplePoint);
  const orangePoint = new THREE.PointLight(0xf97316, 2, 10);
  orangePoint.position.set(1, -1.5, 2);
  scene.add(orangePoint);

  const platMat = new THREE.MeshPhysicalMaterial({ color: 0x0d1035, emissive: 0x3b0764, emissiveIntensity: 0.3, roughness: 0.2, metalness: 0.9 });
  const rimMat  = new THREE.MeshBasicMaterial({ color: 0x7c3aed, transparent: true, opacity: 0.6 });

  const disc1 = new THREE.Mesh(new THREE.CylinderGeometry(2.2, 2.2, 0.18, 64), platMat);
  disc1.position.set(0.3, -2.3, 0);
  scene.add(disc1);

  const disc2 = new THREE.Mesh(new THREE.CylinderGeometry(1.7, 1.7, 0.12, 64), platMat);
  disc2.position.set(0.3, -2.14, 0);
  scene.add(disc2);

  const rimGeo = new THREE.TorusGeometry(2.18, 0.025, 8, 128);
  const rim = new THREE.Mesh(rimGeo, rimMat);
  rim.rotation.x = Math.PI / 2;
  rim.position.set(0.3, -2.21, 0);
  scene.add(rim);

  const rimGeo2 = new THREE.TorusGeometry(1.68, 0.018, 8, 128);
  const rim2 = new THREE.Mesh(rimGeo2, new THREE.MeshBasicMaterial({ color: 0xf97316, transparent: true, opacity: 0.4 }));
  rim2.rotation.x = Math.PI / 2;
  rim2.position.set(0.3, -2.02, 0);
  scene.add(rim2);

  const magGroup = new THREE.Group();
  magGroup.position.set(0.2, -0.8, 1.2);
  scene.add(magGroup);

  const lensMat = new THREE.MeshPhysicalMaterial({
    color: 0x111830,
    emissive: 0x7c3aed,
    emissiveIntensity: 0.1,
    roughness: 0.1,
    metalness: 0.95,
    transparent: true,
    opacity: 0.88,
  });
  const lensRingGeo = new THREE.TorusGeometry(0.9, 0.1, 16, 80);
  const lensRing = new THREE.Mesh(lensRingGeo, lensMat);
  magGroup.add(lensRing);

  const glassGeo = new THREE.CircleGeometry(0.88, 64);
  const glassMat = new THREE.MeshPhysicalMaterial({
    color: 0x1a2060,
    emissive: 0x4c1d95,
    emissiveIntensity: 0.25,
    roughness: 0.05,
    metalness: 0.1,
    transparent: true,
    opacity: 0.35,
    side: THREE.DoubleSide,
  });
  const glass = new THREE.Mesh(glassGeo, glassMat);
  magGroup.add(glass);

  const handleGeo = new THREE.CylinderGeometry(0.07, 0.05, 1.4, 16);
  const handleMat = new THREE.MeshPhysicalMaterial({ color: 0x1a1a3a, roughness: 0.15, metalness: 0.95, emissive: 0x3b0764, emissiveIntensity: 0.2 });
  const handle = new THREE.Mesh(handleGeo, handleMat);
  handle.rotation.z = Math.PI / 4;
  handle.position.set(0.72, -0.72, 0);
  magGroup.add(handle);

  const glowRingGeo = new THREE.TorusGeometry(0.9, 0.015, 8, 80);
  const glowRing = new THREE.Mesh(glowRingGeo, new THREE.MeshBasicMaterial({ color: 0xa78bfa }));
  magGroup.add(glowRing);

  magGroup.rotation.x = 0.2;
  magGroup.rotation.z = -0.15;

  const clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    const t = clock.getElapsedTime();

    controls.update();

    magGroup.position.y = -0.8 + Math.sin(t * 0.65) * 0.12;
    magGroup.rotation.z = -0.15 + Math.sin(t * 0.4) * 0.05;

    purplePoint.intensity = 3.5 + Math.sin(t * 1.2) * 1;
    orangePoint.intensity = 1.5 + Math.sin(t * 0.9 + 1) * 0.6;

    rim.material.opacity = 0.5 + Math.sin(t * 1.5) * 0.15;
    rim2.material.opacity = 0.35 + Math.sin(t + 0.5) * 0.12;

    renderer.render(scene, camera);
  }
  animate();
})();
</script>
